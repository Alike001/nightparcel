// Test-only faucet token for NightParcel's isolated local development network.
// Anyone can mint. It is not a product token and must never be deployed as currency.

pragma language_version 0.23;
import CompactStandardLibrary;

export ledger mintCount: Counter;

export circuit mint(recipient: ZswapCoinPublicKey, amount: Uint<64>, nonce: Bytes<32>): [] {
    assert(amount > 0, "Mint amount must be greater than zero");
    mintShieldedToken(
        pad(32, "nightparcel:demo-token:v1"),
        disclose(amount),
        disclose(nonce),
        left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient))
    );
    mintCount.increment(1);
}
