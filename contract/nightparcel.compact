// NightParcel: confidential invoice commitments for direct, self-custodial payments.
// The contract authenticates merchant state transitions. It never receives payment
// tokens and it cannot independently certify that a wallet-to-wallet payment occurred.

pragma language_version 0.23;
import CompactStandardLibrary;

export struct InvoiceOpening {
    invoiceId: Bytes<32>;
    amount: Uint<128>;
    payeeCoinPublicKey: Bytes<32>;
    payeeEncryptionPublicKey: Bytes<32>;
    expiresAt: Uint<64>;
    termsDigest: Bytes<32>;
}

export struct SettlementEvidence {
    invoiceCommitment: Bytes<32>;
    walletIdentifierDigest: Bytes<32>;
    indexedTransactionHash: Bytes<32>;
    confirmationBlockHash: Bytes<32>;
    amount: Uint<128>;
    tokenColor: Bytes<32>;
    payeeCoinPublicKey: Bytes<32>;
    payeeEncryptionPublicKey: Bytes<32>;
    networkTag: Bytes<32>;
}

export sealed ledger merchantKey: Bytes<32>;
export sealed ledger networkTag: Bytes<32>;
export sealed ledger tokenColor: Bytes<32>;
export ledger invoices: Set<Bytes<32>>;
export ledger cancelled: Set<Bytes<32>>;
export ledger receipts: Map<Bytes<32>, Bytes<32>>;

witness merchantSecret(): Bytes<32>;

constructor(deploymentNetworkTag: Bytes<32>, supportedTokenColor: Bytes<32>) {
    merchantKey = disclose(deriveMerchantKey(merchantSecret()));
    networkTag = disclose(deploymentNetworkTag);
    tokenColor = disclose(supportedTokenColor);
}

circuit deriveMerchantKey(secret: Bytes<32>): Bytes<32> {
    // Compact runtime 4.1.1's constructor context has no deployed address,
    // so constructor-time authorization cannot safely bind kernel.self().
    // A fresh secret is mandatory for every deployment. Invoice and receipt
    // commitments remain address-bound because they are created after deploy.
    return persistentHash<Vector<2, Bytes<32>>>([
        pad(32, "nightparcel:merchant:v1"),
        secret
    ]);
}

circuit requireMerchant(): [] {
    assert(
        deriveMerchantKey(merchantSecret()) == merchantKey,
        "Only the merchant can modify invoices"
    );
}

// Public, side-effect-free verifier for privately shared request files. The
// payer supplies the deployment fields read from the public ledger and can
// therefore reproduce the exact commitment without knowing merchantSecret.
export pure circuit computeInvoiceCommitment(
    contractAddress: Bytes<32>,
    deploymentNetworkTag: Bytes<32>,
    supportedTokenColor: Bytes<32>,
    opening: InvoiceOpening,
    salt: Bytes<32>
): Bytes<32> {
    return persistentCommit<Vector<10, Bytes<32>>>([
        pad(32, "nightparcel:invoice:v1"),
        contractAddress,
        deploymentNetworkTag,
        supportedTokenColor,
        opening.invoiceId,
        opening.amount as Bytes<32>,
        opening.payeeCoinPublicKey,
        opening.payeeEncryptionPublicKey,
        opening.expiresAt as Bytes<32>,
        opening.termsDigest
    ], salt);
}

circuit commitInvoice(opening: InvoiceOpening, salt: Bytes<32>): Bytes<32> {
    return computeInvoiceCommitment(
        kernel.self().bytes,
        networkTag,
        tokenColor,
        opening,
        salt
    );
}

circuit commitReceipt(
    invoiceCommitment: Bytes<32>,
    evidence: SettlementEvidence,
    salt: Bytes<32>
): Bytes<32> {
    return persistentCommit<Vector<11, Bytes<32>>>([
        pad(32, "nightparcel:receipt:v1"),
        kernel.self().bytes,
        invoiceCommitment,
        evidence.walletIdentifierDigest,
        evidence.indexedTransactionHash,
        evidence.confirmationBlockHash,
        networkTag,
        tokenColor,
        evidence.amount as Bytes<32>,
        evidence.payeeCoinPublicKey,
        evidence.payeeEncryptionPublicKey
    ], salt);
}

export circuit createInvoice(opening: InvoiceOpening, invoiceSalt: Bytes<32>): Bytes<32> {
    requireMerchant();
    assert(opening.amount > 0, "Invoice amount must be greater than zero");
    assert(opening.expiresAt > 0, "Invoice expiry must be set");

    const invoiceCommitment = commitInvoice(opening, invoiceSalt);
    assert(!invoices.member(invoiceCommitment), "Invoice already exists");
    invoices.insert(invoiceCommitment);
    return invoiceCommitment;
}

export circuit cancelInvoice(opening: InvoiceOpening, invoiceSalt: Bytes<32>): [] {
    requireMerchant();
    const invoiceCommitment = commitInvoice(opening, invoiceSalt);
    assert(invoices.member(invoiceCommitment), "Invoice does not exist");
    assert(!cancelled.member(invoiceCommitment), "Invoice already cancelled");
    assert(!receipts.member(invoiceCommitment), "Acknowledged invoice cannot be cancelled");
    cancelled.insert(invoiceCommitment);
}

export circuit acknowledgeReceipt(
    opening: InvoiceOpening,
    invoiceSalt: Bytes<32>,
    evidence: SettlementEvidence,
    receiptSalt: Bytes<32>
): Bytes<32> {
    requireMerchant();
    const invoiceCommitment = commitInvoice(opening, invoiceSalt);
    assert(invoices.member(invoiceCommitment), "Invoice does not exist");
    assert(!cancelled.member(invoiceCommitment), "Cancelled invoice cannot be acknowledged");
    assert(!receipts.member(invoiceCommitment), "Invoice already acknowledged");
    assert(
        evidence.invoiceCommitment == invoiceCommitment,
        "Evidence invoice does not match invoice"
    );
    assert(
        evidence.walletIdentifierDigest != default<Bytes<32>>,
        "Wallet transaction identifier digest must be set"
    );
    assert(
        evidence.indexedTransactionHash != default<Bytes<32>>,
        "Indexed transaction hash must be set"
    );
    assert(
        evidence.confirmationBlockHash != default<Bytes<32>>,
        "Confirmation block must be set"
    );
    assert(evidence.amount == opening.amount, "Evidence amount does not match invoice");
    assert(evidence.tokenColor == tokenColor, "Evidence token does not match invoice book");
    assert(
        evidence.payeeCoinPublicKey == opening.payeeCoinPublicKey &&
        evidence.payeeEncryptionPublicKey == opening.payeeEncryptionPublicKey,
        "Evidence recipient does not match invoice"
    );
    assert(evidence.networkTag == networkTag, "Evidence network does not match invoice book");

    const receiptCommitment = commitReceipt(invoiceCommitment, evidence, receiptSalt);
    receipts.insert(invoiceCommitment, receiptCommitment);
    return receiptCommitment;
}
