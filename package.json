{
  "name": "nightparcel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NightParcel: Private Payments. Verifiable Settlement.",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "compile": "compact compile contract/nightparcel.compact contract/managed/nightparcel && compact compile contract/demo-token.compact contract/managed/demo-token",
    "compile:fast": "compact compile --skip-zk contract/nightparcel.compact contract/managed/nightparcel && compact compile --skip-zk contract/demo-token.compact contract/managed/demo-token",
    "test:sim": "vitest run src/**/*.sim.test.ts",
    "test": "vitest run --exclude src/**/*.sim.test.ts --exclude src/**/*.local.test.ts",
    "test:local": "MIDNIGHT_NETWORK=local vitest run src/**/*.local.test.ts",
    "typecheck": "tsc --noEmit -p . && yarn workspace @nightparcel/web typecheck",
    "lint": "eslint . --ignore-pattern apps/web && yarn workspace @nightparcel/web lint",
    "build": "yarn workspace @nightparcel/web build"
  },
  "dependencies": {
    "@midnight-ntwrk/example-sim": "workspace:^",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "effect": "3.22.2",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "resolutions": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1",
    "@midnight-ntwrk/zkir-v2": "2.1.1",
    "vite-plugin-top-level-await/@swc/core": "1.15.47",
    "vite-plugin-top-level-await/uuid": "11.1.1"
  }
}
